        <mxCell id="pu" value="&lt;b&gt;UTILISATEUR&lt;/b&gt;&lt;hr&gt;id_utilisateur BIGINT PK&lt;br&gt;pseudo VARCHAR(40) NOT NULL&lt;br&gt;email VARCHAR(255) NOT NULL UNIQUE" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="110" width="400" height="150" />
        </mxCell>
        <mxCell id="ps" value="&lt;b&gt;SERVEUR&lt;/b&gt;&lt;hr&gt;id_serveur BIGINT PK&lt;br&gt;nom VARCHAR(100) NOT NULL" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="110" width="450" height="120" />
        </mxCell>
        <mxCell id="pa" value="&lt;b&gt;APPARTENANCE&lt;/b&gt;&lt;hr&gt;id_utilisateur BIGINT FK NOT NULL&lt;br&gt;id_serveur BIGINT FK NOT NULL&lt;br&gt;role VARCHAR(20) CHECK (proprietaire, moderateur, membre)&lt;br&gt;PK(id_utilisateur, id_serveur)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="350" width="500" height="180" />
        </mxCell>
        <mxCell id="pp" value="&lt;b&gt;PRÉSENCE&lt;/b&gt;&lt;hr&gt;id_utilisateur BIGINT PK/FK&lt;br&gt;statut VARCHAR(20) NOT NULL&lt;br&gt;derniere_activite TIMESTAMPTZ NOT NULL&lt;br&gt;expire_le TIMESTAMPTZ NOT NULL" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="650" width="430" height="170" />
        </mxCell>
        <mxCell id="pf" value="&lt;b&gt;AMITIÉ&lt;/b&gt;&lt;hr&gt;id_a, id_b BIGINT FK NOT NULL&lt;br&gt;date_acceptation TIMESTAMPTZ NOT NULL&lt;br&gt;PK(id_a, id_b)&lt;br&gt;CHECK(id_a &amp;lt; id_b)&lt;br&gt;INDEX(id_b, id_a)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="650" width="500" height="180" />
        </mxCell>
        <mxCell id="pl" value="&lt;b&gt;SALON&lt;/b&gt;&lt;hr&gt;id_salon BIGINT PK&lt;br&gt;id_serveur BIGINT FK NOT NULL&lt;br&gt;nom VARCHAR(100) NOT NULL&lt;br&gt;type VARCHAR(10) CHECK textuel/vocal&lt;br&gt;UNIQUE(id_serveur, nom)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="350" width="450" height="180" />
        </mxCell>
        <mxCell id="pm" value="&lt;b&gt;MESSAGE&lt;/b&gt;&lt;hr&gt;id_message BIGINT PK&lt;br&gt;id_salon BIGINT FK NOT NULL&lt;br&gt;id_auteur BIGINT FK NOT NULL&lt;br&gt;contenu TEXT NOT NULL&lt;br&gt;date_envoi TIMESTAMPTZ NOT NULL&lt;br&gt;date_modification TIMESTAMPTZ NULL&lt;br&gt;INDEX(id_salon, id_message DESC)&lt;br&gt;INDEX(id_auteur)" style="whiteSpace=wrap;html=1;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
